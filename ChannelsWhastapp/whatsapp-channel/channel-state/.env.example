# whatsapp-channel — credentials & config
# Copy to:  ~/.claude/channels/whatsapp/.env   (chmod 600 on POSIX)
# Plugin children do NOT inherit Claude Code's env, so creds live here.

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=YOUR_EVOLUTION_API_KEY
INSTANCE_NAME=PedroW

# Phones Claude may respond to (E.164, no +). Comma-separated.
#   351915873259 = Pedro   |   17606096731 = Ilya
ALLOWED_PHONES=<PEDRO_PHONE>,<ILYA_PHONE>

# Session gate keywords (handled by the plugin; Claude never sees them)
START_KEYWORD=ai_pedras
STOP_KEYWORD=bye ai_pedras

# How often to pull new messages from Evolution API (ms)
POLL_INTERVAL_MS=3000

# Rich text: auto-convert Markdown (**bold**, ## headings, - bullets, [t](url), `code`)
# into WhatsApp's native formatting (*bold* _italic_ ~strike~ ```mono```) on send.
# Evolution's sendText has no formatting flag — this is the fix. Set to "off" to send
# text byte-for-byte.
RICH_TEXT=on
