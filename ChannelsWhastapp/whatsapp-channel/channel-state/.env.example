# whatsapp-channel — credentials & config
# Copy to:  ~/.claude/channels/whatsapp/.env   (chmod 600 on POSIX)
# Plugin children do NOT inherit Claude Code's env, so creds live here.

EVOLUTION_API_URL=http://localhost:8080
# IMPORTANT: use the INSTANCE token (Evolution Manager -> your instance -> "API Key"
# / "token"), NOT the global server key. The global key authenticates management
# endpoints (fetchInstances) but is rejected with 401 by message/chat endpoints
# like findMessages and sendText, which is exactly what this plugin calls.
EVOLUTION_API_KEY=YOUR_EVOLUTION_INSTANCE_TOKEN
INSTANCE_NAME=PedroW

# Identifiers Claude may respond to. Comma-separated. Normally the phone in
# E.164 without + (e.g. 351915873259). NOTE: WhatsApp may route a contact through
# a "Linked Device ID"; the inbound JID then looks like 266064751554576@lid
# instead of <phone>@s.whatsapp.net. When that happens the plugin logs:
#   Dropped DM: extracted id "266064751554576" from 266064751554576@lid not in ALLOWED=[...]
# Add that printed number (the lid) here too - it is stable per contact.
ALLOWED_PHONES=<PEDRO_PHONE>,<ILYA_PHONE>

# Session gate keywords (handled by the plugin; Claude never sees them)
START_KEYWORD=ai_pedras
STOP_KEYWORD=bye ai_pedras

# How often to pull new messages from Evolution API (ms)
POLL_INTERVAL_MS=3000

# Rich text: auto-convert Markdown (**bold**, ## headings, - bullets, [t](url), `code`)
# into WhatsApp's native formatting (*bold* _italic_ ~strike~ ```mono```) on send.
# Evolution's sendText has no formatting flag — this is the fix. Set to "off" to send
# text byte-for-byte.
RICH_TEXT=on
