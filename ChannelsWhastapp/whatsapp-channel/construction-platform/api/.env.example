# Copy to .env and fill in. The API boots even without a DB (health reports db:false).
PORT=4000
HOST=0.0.0.0

# Either a single connection string...
# DATABASE_URL=postgres://postgres:password@localhost:5432/construction

# ...or discrete vars:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=construction

# AI brain (optional). With no key, dashboard/triage/materials use deterministic
# fallbacks. Set a key to phrase summaries and classify requests with Claude.
# ANTHROPIC_API_KEY=sk-ant-...
# BRAIN_MODEL=claude-haiku-4-5     # cheap default; override per need
# BRAIN_MAX_TOKENS=512
