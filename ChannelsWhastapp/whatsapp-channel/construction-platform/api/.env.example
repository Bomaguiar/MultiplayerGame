# Copy to .env and fill in. The API boots even without a DB (health reports db:false).
PORT=4000
HOST=0.0.0.0

# Either a single connection string...
# DATABASE_URL=postgres://postgres:password@localhost:5432/construction

# ...or discrete vars:
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=construction
