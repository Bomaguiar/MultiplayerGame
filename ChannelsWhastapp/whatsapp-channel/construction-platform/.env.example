# Copy this file to `.env` (same folder as docker-compose.yml) for a real pilot.
# Docker Compose loads it automatically. Leave it absent to run the demo defaults.

# Turn the demo dashboard + seed data OFF for a real pilot (set to 0).
DEMO_MODE=1

# Strong secret the watcher and API share to sign internal tokens. CHANGE THIS.
# Generate one: `openssl rand -hex 32`
INTERNAL_TOKEN_SECRET=demo-secret-change-me

# Postgres password (persisted in the pgdata volume).
POSTGRES_PASSWORD=postgres

# Optional: enable AI-phrased dashboard/triage/materials. Leave blank for
# deterministic fallbacks.
ANTHROPIC_API_KEY=
